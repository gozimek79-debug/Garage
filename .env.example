# PostgreSQL connection string for the API server and Vercel function.
DATABASE_URL=

# Clerk server configuration.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Replit/custom proxy only; leave false for a standard Clerk instance on Vercel.
CLERK_PROXY_ENABLED=false

# Clerk browser configuration.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Keep false outside local development.
ENABLE_DEMO_TOOLS=false
